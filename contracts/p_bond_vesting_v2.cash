// PBondVesting — the launcher's "Product Development" allocation. 10% of supply is carved
// out at genesis into a vault that releases on a fixed schedule: a 2-month cliff, then 10
// equal monthly installments, to a single committed beneficiary key. Not part of upstream
// p-bond.
//
// Claim() is PERMISSIONLESS: anyone may broadcast it once an installment's time threshold
// is reached, no beneficiary signature required. This does NOT let anyone redirect funds
// or change the schedule: the payout destination (beneficiaryLock) and every amount are
// derived directly from the vault's own on-chain commitment, never from the caller, so a
// claim triggered by any third party still pays out to the same fixed beneficiary
// address, in the same amount, on the same schedule. Mirrors the standard "public
// release()" vesting pattern (e.g. OpenZeppelin's VestingWallet) and matches the
// permissionless + cron-automated philosophy the curve contracts already use for
// Initiate/Complete Completion and fee withdrawal. scripts/bonding/cron.ts triggers each
// installment as it comes due; the read-only investor view is VestingDashboardPage.tsx.
//
// LIVE: every self-serve launch's Product Development allocation genesis's into this
// contract (launch.ts -> getVestingContractV2()). An earlier signature-gated version
// (Claim() required the beneficiary's own signature) was retired 2026-09-07 after only
// ever holding internal test allocations; its source is in _superseded/.
//
// Audited (NOTES.md Phase 22 + Phase 29) with the same lens as the curve-contract
// capability fix: the recreated-vault output uses a FULL
// `tokenCategory == tx.inputs[0].tokenCategory` match (pins `mutable`), so it does NOT
// have the curve contract's split-both-sides bug. One low-severity finding (V-1): the
// FINAL-claim payout does not forbid a junk capability=none NFT riding along — cosmetic
// only, lands at the beneficiary's own P2PKH, carries no authority. Covered by
// src/services/bonding/__tests__/vestingSecurity.test.ts.
//
// Trade-off, stated plainly: there is deliberately no recovery path if the beneficiary
// key is lost — a lost key permanently strands whatever has not been released, since
// receiving still requires that key. Permissionless triggering only removes the need for
// the founder to manually claim each month and enables cron automation of the release.
//
// Installments are discrete monthly rather than continuous linear release because of a
// CashScript restriction on how `tx.time` can be used (confirmed by direct compiler
// testing). Months are a flat 30 days.

contract PBondVestingV2(
) {
    function Claim() {
        // Pin the vault to input 0 / its own recreated output to output 0 — same
        // "cheap to state explicitly" reasoning already used throughout this contract
        // family rather than relying on activeInputIndex alone to stay put.
        require(this.activeInputIndex == 0);

        int cliffSeconds = 5184000;   // 2 months @ 30 days
        int periodSeconds = 2592000;  // 1 month @ 30 days, per installment after the cliff
        int totalInstallments = 10;

        bytes beneficiaryPKH, bytes r1 = tx.inputs[0].nftCommitment.split(20);
        bytes vestStartB, bytes r2 = r1.split(4);
        bytes originalAmountB, bytes claimsSoFarB = r2.split(8);

        // No hash160(pk)==beneficiaryPKH / checkSig(s, pk) gate on the caller: every
        // output check below already derives its required destination/amount straight
        // from the commitment itself, never from the caller, so there is nothing for a
        // caller identity check to protect.

        int vestStart = int(vestStartB);
        int originalAmount = int(originalAmountB);
        int claimsSoFar = int(claimsSoFarB);

        // Already fully claimed — nothing left to unlock, ever.
        require(claimsSoFar < totalInstallments);

        // The (claimsSoFar+1)-th installment unlocks at vestStart + cliff, then one
        // more period per prior claim already taken.
        require(tx.time >= vestStart + cliffSeconds + claimsSoFar * periodSeconds);

        int inAmount = tx.inputs[0].tokenAmount;
        int newClaimsSoFar = claimsSoFar + 1;
        int claimableNow = originalAmount / totalInstallments;

        bytes category = tx.inputs[0].tokenCategory.split(32)[0];
        bytes25 beneficiaryLock = new LockingBytecodeP2PKH(unsafe_bytes20(beneficiaryPKH));

        if (newClaimsSoFar < totalInstallments) {
            // Partial claim: recreate the vault at output 0 with the unclaimed
            // remainder, pay out one installment at output 1, allow one optional
            // pure-BCH change output for whoever fronted the tx fee (no longer
            // necessarily the beneficiary — could be a cron relayer now).
            int remaining = inAmount - claimableNow;

            require(tx.outputs.length >= 2);
            require(tx.outputs.length <= 3);

            require(tx.outputs[0].lockingBytecode == tx.inputs[0].lockingBytecode);
            require(tx.outputs[0].tokenCategory == tx.inputs[0].tokenCategory);
            require(tx.outputs[0].tokenAmount == remaining);
            require(tx.outputs[0].nftCommitment ==
                    beneficiaryPKH + vestStartB + originalAmountB + toPaddedBytes(newClaimsSoFar, 1));

            require(tx.outputs[1].lockingBytecode == beneficiaryLock);
            require(tx.outputs[1].tokenCategory == category);
            require(tx.outputs[1].tokenAmount == claimableNow);

            if (tx.outputs.length == 3) {
                require(tx.outputs[2].tokenCategory == 0x);
            }
        } else {
            // Final (10th) installment: release whatever remains in the vault, not
            // just originalAmount/10 again — this absorbs the integer-division
            // remainder from the previous 9 installments so no dust is ever
            // permanently stranded. The vault closes for good; no output recreates it.
            require(tx.outputs.length >= 1);
            require(tx.outputs.length <= 2);

            require(tx.outputs[0].lockingBytecode == beneficiaryLock);
            require(tx.outputs[0].tokenCategory == category);
            require(tx.outputs[0].tokenAmount == inAmount);

            if (tx.outputs.length == 2) {
                require(tx.outputs[1].tokenCategory == 0x);
            }
        }
    }
}
