// PBondVestingV2 — permissionless variant of PBondVesting (p_bond_vesting_v1.cash).
// Anyone may broadcast a Claim() once an installment's time threshold is reached — no
// beneficiary signature is required to trigger it. This does NOT let anyone redirect
// funds: the payout destination (beneficiaryLock) is still derived directly from the
// vault's own on-chain commitment, exactly as in v1, so a claim triggered by any third
// party still pays out to the same fixed beneficiary address, in the same amount, on
// the same schedule. This mirrors the standard "public release()" vesting pattern (e.g.
// OpenZeppelin's VestingWallet, where anyone may call release() but funds are hard-
// locked to the beneficiary) and matches the "permissionless + cron-automated"
// philosophy this pilot's own curve contracts already use for Initiate/Complete
// Completion and fee withdrawal — see scripts/bonding/cron.ts.
//
// v1 is kept unchanged and untouched — see p_bond_vesting_v1.cash and NOTES.md Phase 22
// for the full security review this variant builds on (no vulnerability found in v1;
// this is a product-design change, not a bug fix). v1's own already-genesis'd vaults
// remain claimable only through v1's own contract address/artifact; this is a NEW
// instance for future genesis, not a drop-in replacement — dropping the sig/pubkey ABI
// parameters changes the compiled bytecode and therefore the contract's address
// (add-contract-version checklist step 5).
//
// LIVE since Phase 23: every self-serve launch's "Product Development" allocation now
// genesis's into THIS contract (launch.ts -> getVestingContractV2()), and
// scripts/bonding/cron.ts's auto-release poll step claims due installments against it.
// Re-audited Phase 29 (NOTES.md) with the same lens as the curve-contract capability
// fix: the recreated-vault output uses a FULL `tokenCategory == tx.inputs[0].tokenCategory`
// match (pins `mutable`), so it does NOT have the curve contract's split-both-sides bug.
// One low-severity finding (V-1): the FINAL-claim payout does not forbid a junk
// capability=none NFT riding along — cosmetic only, lands at the beneficiary's own
// P2PKH, carries no authority. Covered by src/services/bonding/__tests__/vestingSecurity.test.ts.
//
// Real trade-off, stated plainly: dropping the identity check does not fix the "lost
// beneficiary key" risk carried over unchanged from v1 — a lost key still permanently
// strands whatever's paid to that P2PKH, since receiving still requires the same key
// spending would have. Permissionless triggering only removes the risk of the founder
// forgetting to manually claim each month, and enables cron automation of the release
// itself (the same class of convenience Initiate/Complete/WithdrawFee already get).
//
// Everything else — schedule constants, commitment layout, dust-remainder absorption on
// the final claim — is byte-for-byte identical to v1. See that file's header for the
// full design rationale (discrete installments forced by CashScript's tx.time
// restriction, 30-day months, etc.).

contract PBondVestingV2(
) {
    function Claim() {
        // Pin the vault to input 0 / its own recreated output to output 0 — same
        // "cheap to state explicitly" reasoning already used throughout this contract
        // family rather than relying on activeInputIndex alone to stay put.
        require(this.activeInputIndex == 0);

        int cliffSeconds = 5184000;   // 2 months @ 30 days
        int periodSeconds = 2592000;  // 1 month @ 30 days, per installment after the cliff
        int totalInstallments = 10;

        bytes beneficiaryPKH, bytes r1 = tx.inputs[0].nftCommitment.split(20);
        bytes vestStartB, bytes r2 = r1.split(4);
        bytes originalAmountB, bytes claimsSoFarB = r2.split(8);

        // No hash160(pk)==beneficiaryPKH / checkSig(s, pk) here — that's the entire
        // diff from v1. Nothing else needs to change: every output check below already
        // derives its required destination/amount straight from the commitment itself,
        // never from the caller, so removing the caller's identity check doesn't loosen
        // any of them.

        int vestStart = int(vestStartB);
        int originalAmount = int(originalAmountB);
        int claimsSoFar = int(claimsSoFarB);

        // Already fully claimed — nothing left to unlock, ever.
        require(claimsSoFar < totalInstallments);

        // The (claimsSoFar+1)-th installment unlocks at vestStart + cliff, then one
        // more period per prior claim already taken.
        require(tx.time >= vestStart + cliffSeconds + claimsSoFar * periodSeconds);

        int inAmount = tx.inputs[0].tokenAmount;
        int newClaimsSoFar = claimsSoFar + 1;
        int claimableNow = originalAmount / totalInstallments;

        bytes category = tx.inputs[0].tokenCategory.split(32)[0];
        bytes25 beneficiaryLock = new LockingBytecodeP2PKH(unsafe_bytes20(beneficiaryPKH));

        if (newClaimsSoFar < totalInstallments) {
            // Partial claim: recreate the vault at output 0 with the unclaimed
            // remainder, pay out one installment at output 1, allow one optional
            // pure-BCH change output for whoever fronted the tx fee (no longer
            // necessarily the beneficiary — could be a cron relayer now).
            int remaining = inAmount - claimableNow;

            require(tx.outputs.length >= 2);
            require(tx.outputs.length <= 3);

            require(tx.outputs[0].lockingBytecode == tx.inputs[0].lockingBytecode);
            require(tx.outputs[0].tokenCategory == tx.inputs[0].tokenCategory);
            require(tx.outputs[0].tokenAmount == remaining);
            require(tx.outputs[0].nftCommitment ==
                    beneficiaryPKH + vestStartB + originalAmountB + toPaddedBytes(newClaimsSoFar, 1));

            require(tx.outputs[1].lockingBytecode == beneficiaryLock);
            require(tx.outputs[1].tokenCategory == category);
            require(tx.outputs[1].tokenAmount == claimableNow);

            if (tx.outputs.length == 3) {
                require(tx.outputs[2].tokenCategory == 0x);
            }
        } else {
            // Final (10th) installment: release whatever remains in the vault, not
            // just originalAmount/10 again — this absorbs the integer-division
            // remainder from the previous 9 installments so no dust is ever
            // permanently stranded. The vault closes for good; no output recreates it.
            require(tx.outputs.length >= 1);
            require(tx.outputs.length <= 2);

            require(tx.outputs[0].lockingBytecode == beneficiaryLock);
            require(tx.outputs[0].tokenCategory == category);
            require(tx.outputs[0].tokenAmount == inAmount);

            if (tx.outputs.length == 2) {
                require(tx.outputs[1].tokenCategory == 0x);
            }
        }
    }
}
