// MINI v2 — same constants as mini_v1, one security fix in the Initiate Completion
// branch (the output NFT capability is now pinned to none; see the SECURITY comment on
// that require() below). mini_v1 is superseded: its address stays inspectable and its
// two mainnet test tokens (Test Ticker / TT 9f2341cb..., Test Tickr 2 / TT2 db36a3a1...,
// both un-graduated) are abandoned in place, same as launch_v1 in NOTES.md Phase 9. No
// live code path should reference mini_v1 going forward.
//
// A deliberately tiny curve for the real-mainnet test of this pilot. Graduates at
// roughly 0.0095 BCH (vs launch_v3's 9.45 BCH), so a full genesis -> buy -> graduation ->
// Cauldron-pool cycle costs a few dollars of real BCH, not ~$3000.
//
// Constants are a SAFE uniform scaling of the proven p_bond_unified_v2_launch_v2.cash
// set (the same discipline launch_v1 violated and permanently bricked itself on -- see
// launch_v2's own header). Two independent scale factors, and this is provably safe:
//
//   - sats domain (x0, initial_sats): divided by 1000. The graduation reserve (and every
//     other sats amount p_bond_complete.cash recomputes) scales by EXACTLY this factor
//     and nothing else -- verified both algebraically and by exact integer simulation of
//     requiredOutSats AND p_bond_complete's dex_sats formula. initial_sats is left at
//     1000 to match launch_v2/ui convention (its effect on the curve is negligible even
//     at this scale).
//   - token domain (max, y0): divided by 10. This factor cancels out of every sats
//     result, so it's free -- chosen so bonding_max (4.5e9) sits cleanly between the ui
//     demo curve's 47.53e6 and launch_v2's 45e9, keeping on-chain variant detection
//     (state.ts / bondingContracts.ts) unambiguous. BCMR decimals for this instance is 4
//     (not 2) -- display total supply 500,000, display max 450,000.
//
// Simulated graduation (fees already swept -- worst case), exact integer math:
//   reserve @ grad      948,304 sats  (~0.00948 BCH)
//   dex_sats each       156,572 sats  x5   (>> 546 dust)
//   feeOut @ Complete   +164,344 sats (17% margin -- launch_v1 went NEGATIVE here)
//   safety ratio        0.8255  (launch_v2 = 0.8264)
//
// Everything else (ABI, branching, every other require() check, commitment layout) is
// byte-for-byte identical to p_bond_unified_v2_launch_v3.cash -- only the two scaled
// constants (bonding_max, bonding_x0, bonding_y0) and the one Initiate-Completion
// capability require() differ. Compiled with cashc 0.13.2.
//
// VERIFIED LIVE ON MAINNET (2026-09-07) -- token TT5, category
// fb790da4ba13fbd4d6de364799f4b2cd47b3e478a0ffd4d8660524f56eab04c3: full cycle broadcast
// and confirmed on-chain -- genesis b93b0ede.., 5 buys + 1 sell, graduation-crossing buy,
// Initiate Completion 29e48a1c.. (output NFT confirmed capability=none -- the fix below
// held), Complete Completion 2347e0d6.. (5 Cauldron pools + reward + fee, feeOut positive
// at ~18%). Also covered by the MockNetworkProvider regression suite in
// src/services/bonding/__tests__/unifiedCompletion.test.ts.

contract PBond_unified_v2(
) {
    function TradeOrWithdrawOrComplete(bytes hashedParams) {
        int bonding_initial_sats = 1000;
        int bonding_max = 4500000000;
        int bonding_x0 = 409851;
        int bonding_y0 = 661338621;
        int bonding_completionPercent = 80;
        int bonding_pshift = 16;
        int bonding_p = ((bonding_max + bonding_y0) / bonding_pshift) * (bonding_initial_sats + bonding_x0);

        bytes paramsHash, bytes fr1 = tx.inputs[this.activeInputIndex].nftCommitment.split(32);
        bytes bonding_minBpsB, bytes fr2 = fr1.split(2);
        bytes bonding_locktimeB, bytes fr3 = fr2.split(4);
        bytes feeRateBpsB, bytes fr4 = fr3.split(2);
        bytes minTradeFeeB, bytes fr5 = fr4.split(2);
        bytes minFeeWithdrawalB, bytes bondingCompletedB = fr5.split(4);

        int bondingCompleted = int(bondingCompletedB);

        if (!bool(bondingCompleted)) {
            int inTokens = tx.inputs[this.activeInputIndex].tokenAmount;
            int outTokens = tx.outputs[this.activeInputIndex].tokenAmount;
            int tokenDifference = outTokens - inTokens;
            int priorRequiredSats = bonding_p / ((inTokens + bonding_y0) / bonding_pshift) - bonding_x0;

            if (bool(tokenDifference)) {
                // Trade (buy or sell)
                int requiredOutSats = bonding_p / ((outTokens + bonding_y0) / bonding_pshift) - bonding_x0;
                int curveDelta = requiredOutSats - priorRequiredSats;
                int satsVolume = abs(curveDelta);
                int feeToAdd = satsVolume * int(feeRateBpsB) / 10000;
                int minTradeFee = int(minTradeFeeB);
                if (feeToAdd < minTradeFee) {
                    feeToAdd = minTradeFee;
                }
                require(tx.outputs[this.activeInputIndex].value >=
                        tx.inputs[this.activeInputIndex].value + curveDelta + feeToAdd);

                if (tokenDifference < 0) {
                    // Buy: 0.01% overshoot floor + graduation trigger
                    require(outTokens >= bonding_max * ((100 - bonding_completionPercent) * 100 - 1) / 10000);
                    if (outTokens <= bonding_max - bonding_max * bonding_completionPercent / 100) {
                        bondingCompleted = 1;
                    }
                } else {
                    // Sell: sniping-protection floor
                    int bonding_minBps = int(bonding_minBpsB);
                    if (outTokens > bonding_max - bonding_max * bonding_minBps / 10000) {
                        int bonding_locktime = int(bonding_locktimeB);
                        require(tx.time >= bonding_locktime);
                    }
                }
                require(hashedParams == 0x);
            } else {
                // Fee withdrawal
                require(tx.inputs.length == 1);
                require(tx.outputs.length == 2);

                int availableFees = tx.inputs[this.activeInputIndex].value - priorRequiredSats;

                require(sha256(hashedParams) == paramsHash);
                bytes clen, bytes crem = hashedParams.split(1);
                bytes frem = crem.split(int(clen))[1];
                bytes flen, bytes frem2 = frem.split(1);
                bytes feePayoutBytecode = frem2.split(int(flen))[0];

                require(tx.outputs[this.activeInputIndex].value == priorRequiredSats);
                // Explicit defense-in-depth check, added after cross-referencing
                // ParyonUSD's audited-contract checklist (require lockingBytecode,
                // tokenCategory, value, tokenAmount, AND nftCommitment on every
                // self-replicating output, every branch). Provably redundant here since
                // this branch is only reached when tokenDifference==0 (i.e. outTokens
                // already equals inTokens by construction, from the read at branch entry)
                // -- but that reasoning is exactly the class of subtlety Paryon's own
                // audited contracts got wrong at first. Cheap to state explicitly rather
                // than rely on control-flow reasoning holding forever under future edits.
                require(tx.outputs[this.activeInputIndex].tokenAmount == inTokens);

                int txFee = 1000;
                int payout = availableFees - txFee;
                require(payout >= int(minFeeWithdrawalB));
                require(tx.outputs[1].value == payout);
                require(tx.outputs[1].lockingBytecode == feePayoutBytecode);
                require(tx.outputs[1].tokenCategory == 0x);
            }

            require(tx.outputs[this.activeInputIndex].lockingBytecode ==
                    tx.inputs[this.activeInputIndex].lockingBytecode);
            require(tx.outputs[this.activeInputIndex].tokenCategory ==
                    tx.inputs[this.activeInputIndex].tokenCategory);
            require(tx.outputs[this.activeInputIndex].nftCommitment ==
                    tx.inputs[this.activeInputIndex].nftCommitment + bytes(bondingCompleted));
        } else {
            // Initiate Completion -- 1 input now, was 2 (main+fee) in the original
            require(tx.inputs.length == 1);
            require(tx.outputs.length == 1);

            require(sha256(hashedParams) == paramsHash);
            bytes clen2, bytes crem2 = hashedParams.split(1);
            bytes completionBytecode = crem2.split(int(clen2))[0];

            int txFee2 = 1000;
            require(tx.outputs[0].value == tx.inputs[0].value - txFee2);
            require(tx.outputs[0].tokenAmount == tx.inputs[0].tokenAmount);
            require(tx.outputs[0].lockingBytecode == completionBytecode);
            // Pin the output to the bare 32-byte category, i.e. capability=none. The
            // curve UTXO input is always capability=mutable (tokenCategory reads back as
            // 33 bytes: category + 0x01 suffix). A none-capability output's tokenCategory
            // is exactly the 32-byte bare category, so comparing the FULL output category
            // against the input's first 32 bytes forces the output NFT to be none and
            // rejects a mutable output. graduate.ts's initiateCompletion() already builds
            // this output as capability=none, so nothing legitimate changes.
            //
            // SECURITY (this is the v2 fix). The previous revision compared .split(32)[0]
            // on BOTH sides, leaving the output capability byte unconstrained. Initiate
            // Completion is permissionless, so an attacker could hand the completion
            // contract a still-mutable NFT. p_bond_complete.cash's Complete() then
            // requires a full tokenCategory match on all 5 DEX outputs plus the burn
            // output, which cannot be satisfied with a single mutable NFT and no minting
            // input, so Complete() becomes permanently unsatisfiable: graduation bricks
            // and the curve reserve is frozen forever. Reported by external peer review,
            // 2026-09. The original two-contract p_bond_main.cash was NOT vulnerable: it
            // pinned the output via the separate capability=none fee input.
            require(tx.outputs[0].tokenCategory == tx.inputs[0].tokenCategory.split(32)[0]);

            bytes hashedCompletionParams = hashedParams +
                                            toPaddedBytes(bonding_p, 8) +
                                            toPaddedBytes(bonding_y0, 8) +
                                            toPaddedBytes(bonding_pshift, 8);
            require(tx.outputs[0].nftCommitment == sha256(hashedCompletionParams));
        }
    }
}
